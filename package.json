{
  "name": "dpacs-final-project",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:access": "node scripts/run-with-root-env.mjs pnpm --filter @repo/access dev",
    "dev:worker": "node scripts/run-with-root-env.mjs pnpm --filter @repo/worker dev",
    "dev:report": "node scripts/run-with-root-env.mjs pnpm --filter @repo/report dev",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:remove": "docker compose rm -sf postgres",
    "db:down": "pnpm db:remove",
    "db:logs": "docker compose logs postgres",
    "valkey:flush": "bash ./scripts/valkey-flush.sh",
    "queue:setup": "bash ./packages/queue/scripts/setup-local.sh",
    "local:up": "bash ./scripts/local-up.sh",
    "local:down": "docker compose down",
    "db:generate": "node scripts/run-with-root-env.mjs pnpm --filter @repo/db generate",
    "db:migrate": "node scripts/run-with-root-env.mjs pnpm --filter @repo/db migrate:dev",
    "db:reset": "node scripts/run-with-root-env.mjs pnpm --filter @repo/db migrate:reset",
    "db:migrate:deploy": "node scripts/run-with-root-env.mjs pnpm --filter @repo/db migrate:deploy",
    "db:seed": "bash ./scripts/db-seed.sh",
    "db:studio": "node scripts/run-with-root-env.mjs pnpm --filter @repo/db studio",
    "build": "pnpm build:app",
    "build:app": "node scripts/workspace-build.mjs",
    "build:image": "node scripts/workspace-build-image.mjs",
    "image:ls": "bash ./scripts/image-ls.sh",
    "image:clean": "bash ./scripts/image-clean.sh",
    "test": "pnpm -r --if-present test",
    "check": "node scripts/workspace-check.mjs"
  }
}
