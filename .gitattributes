# Normalize text files
* text=auto

# Unix/Linux/macOS executable scripts must use LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Docker / compose / yaml should also use LF
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Env files are usually consumed by Unix tooling / Docker
*.env text eol=lf
.env* text eol=lf

# Common project files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows-only scripts can stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf